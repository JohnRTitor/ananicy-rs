[Unit]
Description=Ananicy-Rs - ANother Auto NICe daemon in Rust
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=@bindir@/ananicy-rs start
ExecReload=@bindir@/ananicy-rs --reload
Nice=-5
SuccessExitStatus=143
OOMScoreAdjust=-999

# The daemon announces readiness and shutdown with `sd_notify`. Without this the
# unit is `Type=simple`, whose default `NotifyAccess=` is `none`, so both
# notifications are discarded by the manager and the calls do nothing at all.
NotifyAccess=main

# Delegate the subtree above this unit's cgroup. This does not grant control over
# user.slice, session scopes, or other units.
#
# It also does not, by itself, make CPU bandwidth rules work. `Delegate=yes` alone
# hands over the *parent* (system.slice), which holds processes, so the kernel
# refuses `+cpu` on it ("no internal process"), and every cgroup we create below
# ends up with no cpu.max and no cpu.weight.
#
# `DelegateSubgroup=` is what fixes that, and it is the only thing that does. It
# takes the name of a sub-cgroup for systemd to start this process in, which
# leaves the unit's own cgroup with no processes in it -- and an empty cgroup is
# exactly what the kernel requires before a domain controller can be enabled
# underneath it. We then discover our root one level up, at the unit cgroup, and
# `+cpu` succeeds there, so the cgroups we create get cpu.max and cpu.weight.
#
# Note `CPUWeight=` would NOT achieve this, despite being the obvious thing to
# reach for: a unit's cgroup.subtree_control is enabled from what the unit's
# *children* require, and a leaf service has no children, so it stays empty
# however the unit's own weight is set.
#
# The name is a plain cgroup name -- systemd rejects ones starting with "." or
# "_" -- and it is not a boolean, so `DelegateSubgroup=yes` would create a cgroup
# called "yes". Keep it distinct from any name a .cgroups rule might use: a rule
# that collides with this sub-cgroup would target the daemon's own cgroup.
DelegateSubgroup=delegated
Delegate=yes

Restart=always
RestartSec=10

MemoryHigh=16M
MemoryMax=64M

# Hardening
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes

# `ProtectKernelTunables=yes` mounts `/sys` read-only, which includes the AMD X3D
# driver's `amd_x3d_mode` attribute — so `x3d_mode` in ananicy.conf could never be
# applied, and the failure was only visible as one warning at start-up.
# `ReadWritePaths=` is applied before the read-only remount and is the documented
# way to carve a subdirectory back out of one.
ReadWritePaths=/sys/bus/platform/drivers/amd_x3d_vcache

CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH CAP_SYS_ADMIN CAP_DAC_OVERRIDE
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
NoNewPrivileges=yes

RestrictSUIDSGID=yes
RestrictNamespaces=cgroup
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Required to see other processes
PrivateUsers=no
ProtectProc=default

# Required for the process-listener socket to work
PrivateNetwork=no

# Required for control groups (obviously)
ProtectControlGroups=no

# Required for future use.
RestrictRealtime=no

[Install]
WantedBy=multi-user.target
