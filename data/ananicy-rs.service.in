[Unit]
Description=Ananicy-Rs - ANother Auto NICe daemon in Rust
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=@bindir@/ananicy-rs start
ExecReload=@bindir@/ananicy-rs --reload
Nice=-5
SuccessExitStatus=143
OOMScoreAdjust=-999

# The daemon announces readiness and shutdown with `sd_notify`. Without this the
# unit is `Type=simple`, whose default `NotifyAccess=` is `none`, so both
# notifications are discarded by the manager and the calls do nothing at all.
NotifyAccess=main

# Delegate the subtree above this unit's cgroup. This does not grant control over
# user.slice, session scopes, or other units.
#
# It also does not, by itself, make CPU bandwidth rules work. `Delegate=yes` alone
# hands over the *parent* (system.slice), which holds processes, so the kernel
# refuses `+cpu` on it ("no internal process"), and every cgroup we create below
# ends up with no cpu.max and no cpu.weight. `DelegateSubgroup=` below is what
# fixes that.
#
# Note that `CPUWeight=` would NOT fix it, despite being the obvious thing to
# reach for: a service's own cgroup.subtree_control is populated from what the
# unit's *children* require, and a leaf service has no children, so it stays
# empty however its own weight is set. The parent needs to be an empty cgroup,
# which is what DelegateSubgroup= arranges by moving this process into a
# sub-cgroup of the unit.
#DelegateSubgroup=ananicy
Delegate=yes

Restart=always
RestartSec=10

MemoryHigh=16M
MemoryMax=64M

# Hardening
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes

# `ProtectKernelTunables=yes` mounts `/sys` read-only, which includes the AMD X3D
# driver's `amd_x3d_mode` attribute — so `x3d_mode` in ananicy.conf could never be
# applied, and the failure was only visible as one warning at start-up.
# `ReadWritePaths=` is applied before the read-only remount and is the documented
# way to carve a subdirectory back out of one.
ReadWritePaths=/sys/bus/platform/drivers/amd_x3d_vcache

CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH CAP_SYS_ADMIN CAP_DAC_OVERRIDE
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
NoNewPrivileges=yes

RestrictSUIDSGID=yes
RestrictNamespaces=cgroup
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Required to see other processes
PrivateUsers=no
ProtectProc=default

# Required for the process-listener socket to work
PrivateNetwork=no

# Required for control groups (obviously)
ProtectControlGroups=no

# Required for future use.
RestrictRealtime=no

[Install]
WantedBy=multi-user.target
