[Unit]
Description=Ananicy-Rs - ANother Auto NICe daemon in Rust
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=@bindir@/ananicy-rs start
ExecReload=@bindir@/ananicy-rs --reload
Nice=-5
SuccessExitStatus=143
OOMScoreAdjust=-999

# The daemon announces readiness and shutdown with `sd_notify`. Without this the
# unit is `Type=simple`, whose default `NotifyAccess=` is `none`, so both
# notifications are discarded by the manager and the calls do nothing at all.
NotifyAccess=main

# Delegate the subtree above this unit's cgroup. This does not grant control over
# user.slice, session scopes, or other units.
#
# It also does not, by itself, make CPU bandwidth rules work. `Delegate=yes` alone
# hands over the *parent* (system.slice), which holds processes, so the kernel
# refuses `+cpu` on it ("no internal process"), and every cgroup we create below
# ends up with no cpu.max and no cpu.weight.
#
# `DelegateSubgroup=` is what fixes that, and it is the only thing that does. It
# takes the name of a sub-cgroup for systemd to start this process in, which
# leaves the unit's own cgroup with no processes in it -- and an empty cgroup is
# exactly what the kernel requires before a domain controller can be enabled
# underneath it. We then discover our root one level up, at the unit cgroup, and
# `+cpu` succeeds there, so the cgroups we create get cpu.max and cpu.weight.
#
# Note `CPUWeight=` would NOT achieve this, despite being the obvious thing to
# reach for: a unit's cgroup.subtree_control is enabled from what the unit's
# *children* require, and a leaf service has no children, so it stays empty
# however the unit's own weight is set.
#
# The name is a plain cgroup name -- systemd rejects ones starting with "." or
# "_" -- and it is not a boolean, so `DelegateSubgroup=yes` would create a cgroup
# called "yes". Keep it distinct from any name a .cgroups rule might use: a rule
# that collides with this sub-cgroup would target the daemon's own cgroup.
DelegateSubgroup=delegated
Delegate=yes

Restart=always
RestartSec=10

# A soft line and a hard cap.
#
# `MemoryHigh` is not a limit in the sense `MemoryMax` is: exceeding it makes the
# kernel reclaim rather than failing anything, and the only memory this cgroup
# can reclaim is the daemon's own page cache and heap. So a `MemoryHigh` below
# the working set does not cap anything -- it puts the daemon in a loop where
# every page it touches is discarded and fetched again, which reads as
# unexplained I/O and a slow start. At 16M against a ~40M working set that is
# what this unit used to do, and it cost 3.66 GB of reads in twenty minutes.
#
# 32M is chosen against the *resident* set, not the load peak. Steady state with
# a default rule set was measured at 14.5M, and interning the names a rule set
# shares took roughly 1.8M of that out, so about 13M now: the daemon sits at
# well under half the soft line and the kernel is never asked to reclaim.
#
# A load does cross it. The peak of 34.4M was measured on the build before that
# interning, and it is set by the transient work of loading -- a 712 kB file read
# and a parsed JSON document per line -- not by what stays resident, so reclaim
# during a load is brief and confined to memory that is about to be freed. That
# is the whole difference from the 16M above: there the *sustained* set was over
# the line, so every page the daemon touched was discarded and fetched again.
# Nothing in a rule file says how close a rule set is to that, so check
# `ananicy-rs debug memory` when it matters, and expect the daemon to warn
# rather than to fail quietly.
#
# 64M is the hard cap -- the reference's figure, and twice the soft line to be
# reclaimed back within first. A runaway is still OOM-killed rather than taking
# the machine with it. Note that `OOMScoreAdjust=-999` makes this daemon the last
# candidate the OOM killer picks, so reaching the cap takes some other process
# rather than this one -- which is the argument for the soft line above sitting
# clear of the resident set rather than tight against it.
MemoryHigh=32M
MemoryMax=64M

# Hardening
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes

# `ProtectKernelTunables=yes` mounts `/sys` read-only, which includes the AMD X3D
# driver's `amd_x3d_mode` attribute — so `x3d_mode` in ananicy.conf could never be
# applied, and the failure was only visible as one warning at start-up.
# `ReadWritePaths=` is applied before the read-only remount and is the documented
# way to carve a subdirectory back out of one.
ReadWritePaths=/sys/bus/platform/drivers/amd_x3d_vcache

CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH CAP_SYS_ADMIN CAP_DAC_OVERRIDE
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
NoNewPrivileges=yes

RestrictSUIDSGID=yes
RestrictNamespaces=cgroup
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Required to see other processes
PrivateUsers=no
ProtectProc=default

# Required for the process-listener socket to work
PrivateNetwork=no

# Required for control groups (obviously)
ProtectControlGroups=no

# Required for future use.
RestrictRealtime=no

[Install]
WantedBy=multi-user.target
